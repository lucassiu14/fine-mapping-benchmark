#!/bin/bash
#PBS -N chol_combine_annot
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=04:00:00
#PBS -J 1-22
#PBS -j oe
#PBS -o logs/
# Build the combined annotation set for the second PolyFun variant:
# Borzoi-102 + baselineLF v2.2 = 289 annotations.
#
# The two files share a variant set and row order exactly (verified on chr22:
# identical SNP, BP and A1 sequences, 271,699 rows each), so this is a column
# concatenation rather than a join. The script asserts that alignment rather
# than assuming it.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner; mkdir -p annot_combined logs
require_env APP_VENV "the prep/fb python environment"
source "${APP_VENV}/bin/activate"
report_python
C=${PBS_ARRAY_INDEX}
OUT="annot_combined/combined.${C}.annot.parquet"
[ -s "$OUT" ] && { log "chr$C already combined"; exit 0; }
require_file "annot/borzoi.${C}.annot.parquet" 1000000 "stage 00b incomplete"
require_file "annot/baselineLF.${C}.annot.parquet" 1000000 "stage 00b incomplete"

python - "$C" "$OUT" <<'PY'
import sys, pandas as pd, pyarrow.parquet as pq
c, out = sys.argv[1], sys.argv[2]
key = ["CHR", "SNP", "BP", "A1", "A2"]
b = pq.ParquetFile(f"annot/borzoi.{c}.annot.parquet").read().to_pandas()
l = pq.ParquetFile(f"annot/baselineLF.{c}.annot.parquet").read().to_pandas()
assert len(b) == len(l), f"chr{c}: row counts differ ({len(b)} vs {len(l)})"
for k in ("SNP", "BP", "A1"):
    assert (b[k].values == l[k].values).all(), f"chr{c}: {k} not row-aligned"
lann = [x for x in l.columns if x not in key]
bann = [x for x in b.columns if x not in key]
# The Borzoi files must carry nothing but the 102 PCs beyond the key
# columns. chr6/8/11 of the Sniff release ship a stray pandas `index`
# column, and `key` above does not exclude it -- so without this check it
# would be merged in as a Borzoi annotation on those three chromosomes
# only, and 00g's genome-wide S-LDSC would regress on an annotation set
# that differs by chromosome.
stray = [x for x in bann if "-PC" not in x]
assert not stray, (f"chr{c}: Borzoi file carries non-annotation columns "
                   f"{stray}. Run: python fix_annot_index.py --apply")
assert len(bann) == 102, f"chr{c}: expected 102 Borzoi PCs, got {len(bann)}"
dup = set(lann) & set(bann)
assert not dup, f"chr{c}: annotation names collide: {sorted(dup)[:5]}"
pd.concat([b, l[lann]], axis=1).to_parquet(out, index=False)
print(f"chr{c}: {len(bann)} Borzoi + {len(lann)} baselineLF = "
      f"{len(bann)+len(lann)} annotations, {len(b):,} variants", flush=True)
PY
check_output "$OUT" 1000000
finish
