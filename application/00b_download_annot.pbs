#!/bin/bash
#PBS -N chol_annot_dl
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=12:00:00
#PBS -J 1-22
#PBS -j oe
#PBS -o logs/
# Borzoi-102 annotations, one autosome per task. Public GCS bucket, no auth.
# ~0.4-1.3 GB per chromosome, ~15 GB total.
set -euo pipefail
cd "${APP_ROOT:?set APP_ROOT}"; mkdir -p annot logs
C=${PBS_ARRAY_INDEX}
F="annot/borzoi.${C}.annot.parquet"
if [ -s "$F" ]; then echo "skip chr$C"; exit 0; fi
curl -fsS --retry 5 --retry-delay 10 --max-time 7200 -o "$F.part" \
  "https://storage.googleapis.com/seqnn-share/sniff/processed_borzoi_parquets/borzoi.${C}.annot.parquet"
mv "$F.part" "$F"
echo "chr$C done ($(du -h "$F" | cut -f1))"
