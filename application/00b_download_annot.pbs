#!/bin/bash
#PBS -N chol_annot_dl
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=12:00:00
#PBS -J 1-22
#PBS -j oe
#PBS -o logs/
# Annotations, one autosome per task. Public GCS bucket, no auth.
#   Borzoi-102    ~15 GB total - used by fb_xregion, funmap and PolyFun
#   baselineLF    ~5 GB total  - used by the second PolyFun variant only
set -euo pipefail
cd "${APP_ROOT:?set APP_ROOT}"; mkdir -p annot logs
C=${PBS_ARRAY_INDEX}
G=https://storage.googleapis.com/seqnn-share/sniff

fetch () {  # fetch <url> <dest>
  [ -s "$2" ] && { echo "  skip $(basename "$2")"; return; }
  curl -fsS --retry 5 --retry-delay 10 --max-time 7200 -o "$2.part" "$1"
  mv "$2.part" "$2"
  echo "  got $(basename "$2") ($(du -h "$2" | cut -f1))"
}

# Borzoi-102: the annotation set fb_xregion and funmap use.
fetch "$G/processed_borzoi_parquets/borzoi.${C}.annot.parquet" \
      "annot/borzoi.${C}.annot.parquet"

# baselineLF v2.2 (187 annotations), for the second PolyFun variant. Same
# variant set and row order as the Borzoi file, so 00b2 can combine them by
# column concatenation.
fetch "$G/processed_baselineLF_parquets/baselineLF2.2.UKB.${C}.annot.parquet" \
      "annot/baselineLF.${C}.annot.parquet"
echo "chr$C done"
