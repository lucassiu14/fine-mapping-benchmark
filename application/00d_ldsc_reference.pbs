#!/bin/bash
#PBS -N chol_ldsc_ref
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/
# Reference data for computing the PolyFun prior ourselves: the 1000G EUR
# plink panel (LD-scores) and the HapMap3 LD-score weights.
#
# ~0.30 GB in total. The old alkesgroup.broadinstitute.org/LDSCORE URLs are
# dead (they 404 after redirect); the data now lives in the Zenodo record
# "S-LDSC reference files", 10515792.
#
# EUR is the right panel: the GWAS is UK Biobank white-British and the loci
# are LDetect EUR blocks.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner; mkdir -p logs
Z=https://zenodo.org/records/10515792/files

if [ -d 1000G_EUR_Phase3_plink ]; then echo "plink panel already present"; else
  curl -fL --retry 5 -o plink.tgz "$Z/1000G_Phase3_plinkfiles.tgz?download=1"
  tar xzf plink.tgz && rm -f plink.tgz
fi
if [ -d 1000G_Phase3_weights_hm3_no_MHC ]; then echo "weights already present"; else
  curl -fL --retry 5 -o w.tgz "$Z/1000G_Phase3_weights_hm3_no_MHC.tgz?download=1"
  tar xzf w.tgz && rm -f w.tgz
fi
for C in $(seq 1 22); do
  require_file "1000G_EUR_Phase3_plink/1000G.EUR.QC.${C}.bed" 100000 "plink panel incomplete"
  require_file "1000G_Phase3_weights_hm3_no_MHC/weights.hm3_noMHC.${C}.l2.ldscore.gz" 1000 "weights incomplete"
done
log "plink panel and weights present for all 22 chromosomes"
log "reference data ready"
finish
