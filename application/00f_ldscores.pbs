#!/bin/bash
#PBS -N chol_ldscores
#PBS -l select=1:ncpus=8:mem=96gb
#PBS -l walltime=12:00:00
#PBS -J 1-22
#PBS -j oe
#PBS -o logs/
# LD-scores for one annotation set, one chromosome per task, from the 1000G
# EUR panel. Submit once per ANNOT_SET (sniff, combined).
#
# --allow-missing is REQUIRED: the plink panel contains SNPs with no Borzoi
# annotation and the script aborts otherwise. Measured on chr22, the Borzoi
# set covers 98.5% of the panel, so little is lost.
#
# The output name must follow the LDSC convention <prefix><chr>.l2.ldscore...
# because 00g passes --ref-ld-chr ldscores/borzoi. to PolyFun.
#
# Timing: chr22 took 34 s on 8 cores at 102 annotations. The quintile
# expansion takes that to 409 (sniff) or 596 (combined), so expect roughly 4-6x
# per chromosome, and the annotation matrix reaches ~4 GB at float32 on the
# largest chromosomes - hence 96 GB and 12 h rather than the original 32 GB / 8 h.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner
require_env POLYFUN_ENV "the PolyFun python environment"
source "${POLYFUN_ENV}/bin/activate"
report_python
C=${PBS_ARRAY_INDEX}

# ANNOT_SET selects the PolyFun variant. Both now read the file 00h2 BUILDS,
# not the raw annotations: base (all ones) plus 4 quintile indicators per
# Borzoi PC, because the raw PCs are signed and gave a negative M, and neither
# source set carries a base column. See 00h2_build_annot.pbs.
#   sniff    - base + 102*4 quintile indicators            = 409
#   combined - the same + baselineLF v2.2 as published      = 596
# Computing the LD-scores from the same file PolyFun later reads as 'annot'
# under the --ref-ld-chr prefix is what keeps the two consistent.
SET="${ANNOT_SET:-sniff}"
case "$SET" in sniff|combined) ;; *) echo "ANNOT_SET must be sniff or combined, not '$SET'" >&2; exit 2 ;; esac
ANNOT="ldscores_${SET}/annot.${C}.annot.parquet"
mkdir -p "ldscores_${SET}" logs
# This directory holds all three files PolyFun resolves from one prefix:
# <chr>.annot.parquet (written by 00h2), <chr>.l2.ldscore.parquet (this
# stage) and <chr>.l2.M (00g).
OUT="ldscores_${SET}/annot.${C}.l2.ldscore.parquet"
[ -s "$OUT" ] && { echo "chr$C ($SET) already done"; exit 0; }
[ -s "$ANNOT" ] || { echo "missing annotation file: $ANNOT - run 00h1 then 00h2 with ANNOT_SET=$SET" >&2; exit 1; }

python "${POLYFUN_DIR:?set POLYFUN_DIR}/compute_ldscores.py" \
  --bfile "1000G_EUR_Phase3_plink/1000G.EUR.QC.${C}" \
  --annot "$ANNOT" \
  --out "$OUT" \
  --ld-wind-cm 1 \
  --allow-missing

check_output "$OUT" 10000
python - "$OUT" <<'PY' || die "LD-score output is unusable"
import sys, pyarrow.parquet as pq
f = pq.ParquetFile(sys.argv[1]); c = f.schema_arrow.names
n = len([x for x in c if x not in ("CHR","SNP","BP","A1","A2","CM","MAF")])
print(f"            verified : {f.metadata.num_rows:,} SNPs x {n} annotation LD-scores", flush=True)
assert f.metadata.num_rows > 0, "zero rows"
assert n > 0, "no annotation columns"
PY
log "chr$C ($SET) LD-scores done"
finish
