#!/bin/bash
#PBS -N chol_ldscores
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=08:00:00
#PBS -J 1-22
#PBS -j oe
#PBS -o logs/
# LD-scores for one annotation set, one chromosome per task, from the 1000G
# EUR panel. Submit once per ANNOT_SET (sniff, combined).
#
# --allow-missing is REQUIRED: the plink panel contains SNPs with no Borzoi
# annotation and the script aborts otherwise. Measured on chr22, the Borzoi
# set covers 98.5% of the panel, so little is lost.
#
# The output name must follow the LDSC convention <prefix><chr>.l2.ldscore...
# because 00g passes --ref-ld-chr ldscores/borzoi. to PolyFun.
#
# Timing: chr22 took 34 s on 8 cores; the larger chromosomes scale roughly
# with SNP count.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner
require_env POLYFUN_ENV "the PolyFun python environment"
source "${POLYFUN_ENV}/bin/activate"
report_python
C=${PBS_ARRAY_INDEX}

# ANNOT_SET selects the PolyFun variant:
#   sniff    - the 102 Borzoi PCs, exactly what fb_xregion and funmap see
#   combined - Borzoi-102 + baselineLF v2.2 = 289, the standard S-LDSC setup
SET="${ANNOT_SET:-sniff}"
case "$SET" in
  sniff)    ANNOT="annot/borzoi.${C}.annot.parquet" ;;
  combined) ANNOT="annot_combined/combined.${C}.annot.parquet" ;;
  *) echo "ANNOT_SET must be sniff or combined, not '$SET'" >&2; exit 2 ;;
esac
mkdir -p "ldscores_${SET}" logs
# NB 00g also places <chr>.annot.parquet SYMLINKS in this directory. PolyFun's
# --ref-ld-chr prefix resolves both <prefix><chr>.l2.ldscore.parquet and
# <prefix><chr>.annot.parquet, so the annotations have to sit beside the
# LD-scores under one prefix. The links are 00g's business, not this stage's;
# they are mentioned here only so their appearance is not a surprise.
OUT="ldscores_${SET}/annot.${C}.l2.ldscore.parquet"
[ -s "$OUT" ] && { echo "chr$C ($SET) already done"; exit 0; }
[ -s "$ANNOT" ] || { echo "missing annotation file: $ANNOT" >&2; exit 1; }

python "${POLYFUN_DIR:?set POLYFUN_DIR}/compute_ldscores.py" \
  --bfile "1000G_EUR_Phase3_plink/1000G.EUR.QC.${C}" \
  --annot "$ANNOT" \
  --out "$OUT" \
  --ld-wind-cm 1 \
  --allow-missing

check_output "$OUT" 10000
python - "$OUT" <<'PY' || die "LD-score output is unusable"
import sys, pyarrow.parquet as pq
f = pq.ParquetFile(sys.argv[1]); c = f.schema_arrow.names
n = len([x for x in c if x not in ("CHR","SNP","BP","A1","A2","CM","MAF")])
print(f"            verified : {f.metadata.num_rows:,} SNPs x {n} annotation LD-scores", flush=True)
assert f.metadata.num_rows > 0, "zero rows"
assert n > 0, "no annotation columns"
PY
log "chr$C ($SET) LD-scores done"
finish
