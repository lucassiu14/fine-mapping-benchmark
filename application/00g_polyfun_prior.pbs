#!/bin/bash
#PBS -N chol_pf_prior
#PBS -l select=1:ncpus=64:mem=450gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o logs/
# Compute the PolyFun prior ourselves, from our own annotations.
#
# MEMORY: 450 GB, raised from 64 GB after both jobs were oom-killed (exit 137,
# "Cgroup mem limit exceeded ... task=python") about 10 minutes in, right after
# "inputs verified" and inside the first polyfun.py call.
#
# The cause is in ldsc_polyfun/parse.ldscore(): with --ref-ld-chr it appends
# all 22 chromosomes' LD-score frames to a list and only then does
# pd.concat(chr_ld, axis=0), so the whole genome-wide matrix is held TWICE at
# the peak. The LD-scores are float64 (hence 27 GB / 38 GB on disk for the two
# sets), and the panel is ~9.8M SNPs:
#
#   sniff     9.8M x 409 x 8B  = 33 GB  -> ~65 GB at the concat peak
#   combined  9.8M x 596 x 8B  = 48 GB  -> ~95 GB at the concat peak
#
# which is why 64 GB died for both. A standard PolyFun run on baselineLF's 187
# annotations needs ~15 GB at the same peak, so nothing about the published
# workflow suggests this; it is the quintile expansion (409/596 annotations)
# that moves it. 450 GB is the v1_medium ceiling and leaves ~4x headroom over
# the estimate, which is deliberate: the estimate is arithmetic, not a
# measurement, and the merge with the sumstats that follows adds copies this
# does not account for. If the 64-cpu request queues badly, v1_small tops out
# at 128 gb (enough for sniff, not for combined) and v1_large offers 920 gb.
#
# Three stages of the authors' polyfun.py, run genome-wide. S-LDSC is a
# genome-wide regression, so this CANNOT be restricted to the 265 significant
# blocks - doing so would be selection on the outcome. (--chr applies only to
# --compute-ldscores, not to --compute-h2-L2.)
#
# Two variants, selected by ANNOT_SET:
#   sniff     102 Borzoi PCs only. Non-standard for S-LDSC - enrichment may be
#             biased without baseline controls - but PolyFun then sees exactly
#             what fb_xregion and funmap see, so the comparison isolates the
#             method rather than the annotation set.
#   combined  Borzoi-102 + baselineLF v2.2 = 289. The standard S-LDSC setup,
#             and PolyFun at its strongest; any advantage it shows here may be
#             the extra 187 annotations rather than the method.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner
require_env POLYFUN_ENV "the PolyFun python environment"
source "${POLYFUN_ENV}/bin/activate"
report_python
PF="${POLYFUN_DIR:?set POLYFUN_DIR}"

# PolyFun's default binning step calls the R package Ckmeans.1d.dp through
# rpy2, so the embedded R has to be able to see it. Checked here, in seconds,
# rather than discovered after the ridge regression has run for 20 minutes.
rpy2_env
require_r_package Ckmeans.1d.dp
W=1000G_Phase3_weights_hm3_no_MHC/weights.hm3_noMHC.
SET="${ANNOT_SET:-sniff}"
case "$SET" in sniff|combined) ;; *) echo "ANNOT_SET must be sniff or combined" >&2; exit 2 ;; esac
LDS="ldscores_${SET}/annot."
OUTP="pf_prior_${SET}/chol"
mkdir -p "pf_prior_${SET}" logs
echo "[prior] annotation set: $SET"

# --- PolyFun's --ref-ld-chr prefix locates THREE files per chromosome -----
# Verified in the authors' source, not assumed:
#
#   polyfun.py check_files()        for --compute-h2-L2, per chromosome:
#                                     'ref-ld', 'w-ld' AND 'annot'
#   polyfun_utils.get_file_name()   'ref-ld' -> <prefix><chr>.l2.ldscore.parquet
#                                   'annot'  -> <prefix><chr>.annot.parquet
#   ldsc_polyfun/parse.M()          <prefix><chr>.l2.M, via _read_M
#
# which is exactly what the authors' example_data/ contains per chromosome.
# All three live under ldscores_<SET>/annot.:
#
#   .annot.parquet       written by 00h2 (base + quintile indicators)
#   .l2.ldscore.parquet  written by 00f, FROM that same file
#   .l2.M                written below
#
# The annotations are genuinely read, not merely checked: load_annotations_file()
# uses them for the ridge/bins step and asserts their column names match the
# LD-score columns - which holds because 00f computed those LD-scores from this
# very file.
require_dir "ldscores_${SET}" "run 00h1, then 00h2 and 00f with ANNOT_SET=$SET"

# --- the .l2.M files, which compute_ldscores.py does not write ------------
# parse.M() does a bare open(<prefix><chr>.l2.M).readline(), with no parquet
# fallback and no way to derive it, and check_files() does not verify it - so
# without this PolyFun fails later, inside _read_M. Derived from the existing
# LD-score and annotation files, so nothing is recomputed. See
# make_ldscore_M.py for the definition and its provenance in ldsc.py.
section "M files"
# --annot-prefix is the BUILT file, not the raw annotations: the LD-scores
# were computed from the built file, so M must be its column sums over the
# same SNPs.
python "$APP_ROOT/make_ldscore_M.py" \
  --ldscores-dir "ldscores_${SET}" \
  --annot-prefix "ldscores_${SET}/annot" \
  --polyfun-dir "$PF"

# Check every input up front, so a gap fails here with a clear message rather
# than inside PolyFun after it has loaded the sumstats.
for C in $(seq 1 22); do
  require_file "ldscores_${SET}/annot.${C}.l2.ldscore.parquet" 10000 \
    "LD-scores for chr$C - run 00f with ANNOT_SET=$SET"
  require_file "ldscores_${SET}/annot.${C}.annot.parquet" 100000 \
    "built annotations for chr$C - run 00h2 with ANNOT_SET=$SET"
  require_file "ldscores_${SET}/annot.${C}.l2.M" 2 "M file for chr$C"
  require_file "${W}${C}.l2.ldscore.gz" 1000 "HapMap3 LD-score weights for chr$C - run 00d"
done
require_file munged.parquet 1000000 "munged sumstats - run 00e"
log "inputs verified: 22 chromosomes x (LD-scores + annotations + M + weights), sumstats"

# --- stage 1: S-LDSC -> per-SNP h2 (ridge) and the snpvar bins -------------
# Guard on BOTH artifacts stage 1 produces. It writes snpvar_ridge first and
# the bins afterwards (polyfun_h2_L2: run_ldsc -> compute_snpvar ->
# save_snpvar_to_disk x2 -> partition_snps_to_bins -> save_bins_to_disk), and
# the binning is exactly where it failed for want of the R package
# Ckmeans.1d.dp. Keying on snpvar_ridge alone would declare stage 1 done and
# skip to stage 2, which then dies in check_files for want of the bins:
#   if args.compute_ldscores and not args.compute_h2_L2:
#       get_file_name(args, 'snpvar_ridge', ...); get_file_name(args, 'bins', ...)
if [ ! -s ${OUTP}.22.snpvar_ridge.gz ] || [ ! -s ${OUTP}.22.bins.parquet ]; then
  python "$PF/polyfun.py" \
    --compute-h2-L2 \
    --output-prefix "$OUTP" \
    --sumstats munged.parquet \
    --ref-ld-chr "$LDS" \
    --w-ld-chr "$W" \
    --allow-missing
else echo "stage 1 already done"; fi

# --- stage 2: LD-scores of the snpvar bins ---------------------------------
if [ ! -s ${OUTP}.22.l2.ldscore.parquet ]; then
  python "$PF/polyfun.py" \
    --compute-ldscores \
    --output-prefix "$OUTP" \
    --bfile-chr 1000G_EUR_Phase3_plink/1000G.EUR.QC. \
    --ld-wind-cm 1
else echo "stage 2 already done"; fi

# --- stage 3: re-estimate h2 per bin -> the final prior --------------------
if [ ! -s ${OUTP}.22.snpvar_constrained.gz ]; then
  python "$PF/polyfun.py" \
    --compute-h2-bins \
    --output-prefix "$OUTP" \
    --sumstats munged.parquet \
    --w-ld-chr "$W" \
    --allow-missing
else echo "stage 3 already done"; fi

n_done=$(ls "${OUTP}".*.snpvar_constrained.gz 2>/dev/null | wc -l)
[ "$n_done" -eq 22 ] || die "expected 22 snpvar_constrained files, found $n_done. S-LDSC is genome-wide; check the log above for which chromosome failed."
python - "${OUTP}.22.snpvar_constrained.gz" <<'PY' || die "the prior is unusable"
import sys, pandas as pd, numpy as np
d = pd.read_csv(sys.argv[1], sep="\t")
need = {"CHR","SNP","BP","A1","A2","SNPVAR"}
assert need <= set(d.columns), f"missing columns: {need - set(d.columns)}"
assert len(d) > 0, "zero rows"
assert np.isfinite(d.SNPVAR).all(), "SNPVAR contains non-finite values"
assert (d.SNPVAR > 0).all(), "SNPVAR contains non-positive values"
print(f"            verified : {len(d):,} SNPs, SNPVAR in "
      f"[{d.SNPVAR.min():.3e}, {d.SNPVAR.max():.3e}]", flush=True)
PY
echo
echo "prior ready. Per-chromosome files carry CHR SNP BP A1 A2 SNPVAR MAF N Z,"
echo "which is what 05_polyfun.pbs feeds to finemapper.py:"
ls -la "${OUTP}".*.snpvar_constrained.gz | head -3
echo "($(ls "${OUTP}".*.snpvar_constrained.gz | wc -l) of 22 chromosomes, set=$SET)"
finish
