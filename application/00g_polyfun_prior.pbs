#!/bin/bash
#PBS -N chol_pf_prior
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o logs/
# Compute the PolyFun prior ourselves, from our own annotations.
#
# Three stages of the authors' polyfun.py, run genome-wide. S-LDSC is a
# genome-wide regression, so this CANNOT be restricted to the 265 significant
# blocks - doing so would be selection on the outcome. (--chr applies only to
# --compute-ldscores, not to --compute-h2-L2.)
#
# Two variants, selected by ANNOT_SET:
#   sniff     102 Borzoi PCs only. Non-standard for S-LDSC - enrichment may be
#             biased without baseline controls - but PolyFun then sees exactly
#             what fb_xregion and funmap see, so the comparison isolates the
#             method rather than the annotation set.
#   combined  Borzoi-102 + baselineLF v2.2 = 289. The standard S-LDSC setup,
#             and PolyFun at its strongest; any advantage it shows here may be
#             the extra 187 annotations rather than the method.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner
require_env POLYFUN_ENV "the PolyFun python environment"
source "${POLYFUN_ENV}/bin/activate"
report_python
PF="${POLYFUN_DIR:?set POLYFUN_DIR}"
W=1000G_Phase3_weights_hm3_no_MHC/weights.hm3_noMHC.
SET="${ANNOT_SET:-sniff}"
case "$SET" in sniff|combined) ;; *) echo "ANNOT_SET must be sniff or combined" >&2; exit 2 ;; esac
LDS="ldscores_${SET}/annot."
OUTP="pf_prior_${SET}/chol"
mkdir -p "pf_prior_${SET}" logs
echo "[prior] annotation set: $SET"

# --- stage 1: S-LDSC -> per-SNP h2 (ridge) and the snpvar bins -------------
if [ ! -s ${OUTP}.22.snpvar_ridge.gz ]; then
  python "$PF/polyfun.py" \
    --compute-h2-L2 \
    --output-prefix "$OUTP" \
    --sumstats munged.parquet \
    --ref-ld-chr "$LDS" \
    --w-ld-chr "$W" \
    --allow-missing
else echo "stage 1 already done"; fi

# --- stage 2: LD-scores of the snpvar bins ---------------------------------
if [ ! -s ${OUTP}.22.l2.ldscore.parquet ]; then
  python "$PF/polyfun.py" \
    --compute-ldscores \
    --output-prefix "$OUTP" \
    --bfile-chr 1000G_EUR_Phase3_plink/1000G.EUR.QC. \
    --ld-wind-cm 1
else echo "stage 2 already done"; fi

# --- stage 3: re-estimate h2 per bin -> the final prior --------------------
if [ ! -s ${OUTP}.22.snpvar_constrained.gz ]; then
  python "$PF/polyfun.py" \
    --compute-h2-bins \
    --output-prefix "$OUTP" \
    --sumstats munged.parquet \
    --w-ld-chr "$W" \
    --allow-missing
else echo "stage 3 already done"; fi

n_done=$(ls "${OUTP}".*.snpvar_constrained.gz 2>/dev/null | wc -l)
[ "$n_done" -eq 22 ] || die "expected 22 snpvar_constrained files, found $n_done. S-LDSC is genome-wide; check the log above for which chromosome failed."
python - "${OUTP}.22.snpvar_constrained.gz" <<'PY' || die "the prior is unusable"
import sys, pandas as pd, numpy as np
d = pd.read_csv(sys.argv[1], sep="\t")
need = {"CHR","SNP","BP","A1","A2","SNPVAR"}
assert need <= set(d.columns), f"missing columns: {need - set(d.columns)}"
assert len(d) > 0, "zero rows"
assert np.isfinite(d.SNPVAR).all(), "SNPVAR contains non-finite values"
assert (d.SNPVAR > 0).all(), "SNPVAR contains non-positive values"
print(f"            verified : {len(d):,} SNPs, SNPVAR in "
      f"[{d.SNPVAR.min():.3e}, {d.SNPVAR.max():.3e}]", flush=True)
PY
echo
echo "prior ready. Per-chromosome files carry CHR SNP BP A1 A2 SNPVAR MAF N Z,"
echo "which is what 05_polyfun.pbs feeds to finemapper.py:"
ls -la "${OUTP}".*.snpvar_constrained.gz | head -3
echo "($(ls "${OUTP}".*.snpvar_constrained.gz | wc -l) of 22 chromosomes, set=$SET)"
finish
