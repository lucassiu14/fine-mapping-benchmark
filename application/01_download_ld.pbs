#!/bin/bash
#PBS -N chol_ld_dl
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=08:00:00
#PBS -J 1-262
#PBS -j oe
#PBS -o logs/
# Download one UKBB LD window per array task (.npz + .gz).
# 249 windows, ~1.2 GB each -> ~300 GB total. The bucket is public: no
# credentials, no requester-pays. Re-running is safe; existing files skip.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner
mkdir -p ld logs

# awscli is usually built against a different toolchain than Python, so it is
# loaded here rather than through APP_MODULES where it could conflict.
[ -n "${AWS_MODULE:-}" ] && try_module "$AWS_MODULE"
require_cmd aws

W=$(sed -n "${PBS_ARRAY_INDEX}p" ld_windows.txt)
[ -n "$W" ] || { echo "no window at line ${PBS_ARRAY_INDEX}"; exit 1; }

for ext in gz npz; do
  out="ld/${W}.${ext}"
  if [ -s "$out" ]; then echo "skip $out"; continue; fi
  aws s3 cp --no-sign-request \
      "s3://broad-alkesgroup-ukbb-ld/UKBB_LD/${W}.${ext}" "$out.part"
  mv "$out.part" "$out"          # atomic: a killed job never leaves a half file
  log "got $out ($(du -h "$out" | cut -f1))"
done

# A truncated .npz downloads "successfully" and then fails hours later inside
# prep, so open it here where the error is attributable.
require_file "ld/${W}.npz" 1000000 "download truncated"
require_file "ld/${W}.gz"     1000 "download truncated"
# Use the venv python explicitly, not bare python3. Loading awscli can make
# Lmod swap the GCCcore-12.3.0 Python for the awscli toolchain's, leaving
# `python3` as an interpreter with no scipy - and this check needs scipy.
VPY="${APP_VENV:-}/bin/python"
[ -x "$VPY" ] || VPY=python3
"$VPY" - "ld/${W}.npz" <<'PY' || die "ld/${W}.npz is corrupt - delete it and resubmit this task"
import sys, scipy.sparse as sp
m = sp.load_npz(sys.argv[1])
print(f"            verified : {m.shape[0]} x {m.shape[1]} sparse matrix", flush=True)
PY
finish
