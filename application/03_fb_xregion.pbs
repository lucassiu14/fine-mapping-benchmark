#!/bin/bash
#PBS -N chol_fb_xregion
#PBS -l select=1:ncpus=16:mem=128gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o logs/
# fb_xregion: ONE job over all blocks - the prior head is shared across them,
# so this cannot be an array job.
#
# Memory: the trainer holds every block's LD resident. Measured float32 LD for
# the 252 blocks is ~69 GB; annotations ~0.8 GB; fixed torch/eigensolver
# overhead ~2 GB. 128 GB leaves comfortable headroom. Mini-batching is NOT
# needed at this scale.
#
# Time: 5 blocks x 2000 iterations took 366 s wall. Setup is O(p^3) per block
# (regularize_ld always falls through to eigendecomposition on real float32
# UKBB LD) and will dominate. MEASURE with a 10-block manifest before
# trusting the 48 h walltime.
set -euo pipefail
cd "${APP_ROOT:?set APP_ROOT}"
mkdir -p joint_out logs
source "${APP_VENV:?set APP_VENV}/bin/activate"

# Manifest is rebuilt each run so a re-prep is always picked up.
printf 'z\tLD\tannot\ttarget\tN\n' > manifest.tsv
while IFS=, read -r rid rest; do
  [ "$rid" = region_id ] && continue
  d="regions/$rid"
  [ -f "$d/DONE" ] || { echo "MISSING prep: $rid" >&2; continue; }
  printf '%s\t%s\t%s\t%s\t%s\n' "$d/locus.z" "$d/locus_ld.npy" "$d/locus.annot" \
         "joint_out/$rid" "${N_LIKELIHOOD:-337000}" >> manifest.tsv
done < blocks.csv
echo "manifest: $(( $(wc -l < manifest.tsv) - 1 )) blocks"

# --- guard: refuse to run against a checkout missing the memo fix ----------
# These fixes landed on main in 7a46a13. Any checkout older than that silently
# produces diluted PIPs: reformat_memo would subtract the MEAN
# log-BF instead of the max, saturating 27-53% of the memo at the 1e15 clamp
# and turning calculate_pip into a count of visited configurations. Max PIP
# collapses to ~0.02-0.05 and no credible set is ever formed. It fails
# quietly, looks like a modelling result, and is the single most expensive
# mistake available here - so check for it rather than trusting the checkout.
: "${FB_DIR:?set FB_DIR to the functional-beatrice checkout}"
grep -q 'm0 = max(' "${FB_DIR}/scripts/trainer_annot.py" || {
  echo "FATAL: ${FB_DIR} is missing the reformat_memo max-offset fix." >&2
  echo "       Update the checkout to main at d0fb022 or later." >&2
  exit 1
}
grep -q 'nearest PD correlation matrix' "${FB_DIR}/scripts/trainer_annot.py" || {
  echo "FATAL: ${FB_DIR} is missing the LD regularisation fix." >&2
  echo "       The diagonal shift scales every implied correlation by 1/(1+c)," >&2
  echo "       which makes the Bayes factor FAVOUR co-including collinear variants." >&2
  echo "       Update the checkout to main at d0fb022 or later." >&2
  exit 1
}
grep -q 'def read_ld' "${FB_DIR}/scripts/joint_trainer.py" || {
  echo "FATAL: ${FB_DIR} is missing .npy LD support; the manifest points at .npy files." >&2
  exit 1
}
echo "[guard] fb checkout has the memo fix, the LD regularisation fix and .npy LD support"

python "${FB_DIR}/beatrice_joint.py" \
  --manifest manifest.tsv \
  --N "${N_LIKELIHOOD:-337000}" \
  --n_caus 10 --max_iter 2000 --prior_head lassonet \
  --save_prior_weights joint_out/prior_head.pt
