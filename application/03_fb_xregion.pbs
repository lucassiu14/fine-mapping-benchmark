#!/bin/bash
#PBS -N chol_fb_xregion
#PBS -l select=1:ncpus=4:mem=112gb
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o logs/
# fb_xregion: ONE job over all blocks - the prior head is shared across them,
# so this cannot be an array job.
#
# Memory: the trainer holds every block's LD resident. See the measured figures
# below; mini-batching is NOT needed at this scale, but the headroom is
# narrower than the original estimate suggested.
#
# Time: MEASURED by 03t_fb_timing.pbs on 10 blocks sampled across the size
# distribution of the 254 analysed blocks (p 2,759-16,003):
#
#     3,338 s for 10 blocks
#     -> 23.6 h for 254 if cost is linear in block count
#     -> 19.1 h for 254 if scaled by the sum of p^3
#
# so 19-24 h. The earlier estimate of ~5.4 h came from an old "5 blocks x 2000
# iterations took 366 s" datapoint and was out by 4x, because those 5 blocks
# were far smaller than the real ones. Hence 72 h rather than 48: this is a
# SINGLE job over all blocks (the prior head is shared, so it cannot be an
# array), so an overrun loses the whole run, and 72 h is the ceiling of the
# same queue class as 48 h at these resources - the extra margin is free.
#
# Memory: measured 15.3 GB for those 10 blocks with 3.6 GB of LD resident.
# Across 254 blocks the LD is 83 GB, plus ~12 GB of fixed overhead, plus the
# largest block's O(p^3) solve (p = 16,003: a 2 GB float64 matrix and its eigh
# workspace) -> roughly 100 GB against the 128 GB requested. That is ~27%
# headroom, which is adequate but not generous; if this OOMs, 450 GB is
# available in v1_medium at 64 cpus.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner
mkdir -p joint_out logs
require_env APP_VENV "the prep/fb python environment"
source "${APP_VENV}/bin/activate"
report_python

# Manifest is rebuilt each run so a re-prep is always picked up.
N_EXCL=0
printf 'z\tLD\tannot\ttarget\tN\n' > manifest.tsv
while IFS=, read -r rid rest; do
  [ "$rid" = region_id ] && continue
  d="regions/$rid"
  [ -f "$d/EXCLUDED" ] && { N_EXCL=$((N_EXCL+1)); continue; }
  [ -f "$d/DONE" ] || { echo "MISSING prep: $rid" >&2; continue; }
  printf '%s\t%s\t%s\t%s\t%s\n' "$d/locus.z" "$d/locus_ld.npy" "$d/locus.annot" \
         "joint_out/$rid" "${N_LIKELIHOOD:-337000}" >> manifest.tsv
done < blocks.csv
N_MAN=$(( $(wc -l < manifest.tsv) - 1 ))
N_BLK=$(( $(wc -l < blocks.csv) - 1 - N_EXCL ))
log "manifest : $N_MAN of $N_BLK analysed blocks ($N_EXCL excluded by the unannotated-gap rule)"
[ "$N_MAN" -gt 0 ] || die "manifest is empty - run 02_prep first"
if [ "$N_MAN" -lt "$N_BLK" ]; then
  warn "$(( N_BLK - N_MAN )) blocks are missing from the manifest."
  warn "fb_xregion shares one prior head across blocks, so a partial set changes"
  warn "the fit. Run 'python preflight.py prep' and finish 02 before relying on this."
fi
log "LD resident at float32 will be roughly:"
python - <<'PY'
import os, numpy as np
tot = sum(os.path.getsize(l.split("\t")[1]) for l in open("manifest.tsv").readlines()[1:])
print(f"            {tot/1e9:.0f} GB across the manifest", flush=True)
PY

require_fb_fixes

# Match the thread pools to the allocation. Nothing in FB or this script pinned
# them, so on a 16-cpu request torch and the BLAS were free to spawn 16 threads
# - and the measured run (job 4470340) got nothing for it: cput 21:02:42
# against walltime 21:17:16, a ratio of 0.988, so no measurable parallelism at
# any point in 21 hours. The 16 cpus only made the job hard to place
# ("Placement set is too small"), so the request is now 4.
#
# Pinning matters BECAUSE of that reduction: left unset, the libraries size
# their pools from the node's core count, not the cgroup's, and would
# oversubscribe 4 cores with 16+ threads. Pinning to NCPUS cannot slow a
# workload already measured at one thread.
export OMP_NUM_THREADS="${NCPUS:-4}"
export MKL_NUM_THREADS="${NCPUS:-4}"
export OPENBLAS_NUM_THREADS="${NCPUS:-4}"
log "threads  : OMP/MKL/OPENBLAS = ${NCPUS:-4} (matched to the allocation)"

python "${FB_DIR}/beatrice_joint.py" \
  --manifest manifest.tsv \
  --N "${N_LIKELIHOOD:-337000}" \
  --n_caus 10 --max_iter 2000 --prior_head lassonet \
  --save_prior_weights joint_out/prior_head.pt

section "verifying output"
MISS=0
while IFS=$'\t' read -r _ _ _ tgt _; do
  [ -s "$tgt/pip.csv" ] || { warn "no pip.csv for $(basename "$tgt")"; MISS=$((MISS+1)); }
done < <(tail -n +2 manifest.tsv)
[ "$MISS" -eq 0 ] || die "$MISS of $N_MAN blocks produced no pip.csv"
check_output joint_out/prior_head.pt 1000
log "all $N_MAN blocks produced PIPs"
finish
