#!/bin/bash
#PBS -N chol_polyfun
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=12:00:00
#PBS -J 1-265
#PBS -j oe
#PBS -o logs/
# PolyFun + SuSiE, one block per array task, using the AUTHORS' finemapper.py.
#
# Stage 1 (annotations -> per-SNP prior causal variance, SNPVAR) is computed
# by 00g from OUR annotation set, not downloaded. The published priors in the
# Sniff bucket are for the same GWAS - verified: N, Z and MAF match to within
# text rounding over 209,974 clean 1:1 matches on chr22 - but which annotation
# set produced them cannot be established, because the bucket holds only
# stage-2 intermediates (snpvar bins), and a scalar SNPVAR cannot be
# reverse-engineered. 00c can still fetch them as a cross-check.
#
# finemapper.py reads the UKBB .npz/.gz pair natively via load_ld_npz(), so it
# consumes exactly the LD we already downloaded - no conversion.
cd "${APP_ROOT:?set APP_ROOT (then: source $APP_ROOT/env.sh)}"
source ./lib.sh
banner
SET="${ANNOT_SET:-sniff}"
case "$SET" in sniff|combined) ;; *) echo "ANNOT_SET must be sniff or combined" >&2; exit 2 ;; esac
mkdir -p "polyfun_out_${SET}" logs
# Activate POLYFUN_ENV, which may be a venv or a conda env. Written as an
# if/else rather than `source ... || conda activate ...` because the latter
# parses as `(A || B) && C` and runs conda activate even when the venv
# activated cleanly, failing the job under `set -e`.
: "${POLYFUN_ENV:?set POLYFUN_ENV to the PolyFun venv or conda env}"
if [ -f "${POLYFUN_ENV}/bin/activate" ]; then
  # shellcheck disable=SC1091
  source "${POLYFUN_ENV}/bin/activate"
else
  eval "$(conda shell.bash hook)"
  conda activate "${POLYFUN_ENV}"
fi

# PolyFun calls susieR through rpy2. rpy2_env sets R_HOME, R_LIBS and
# RPY2_CFFI_MODE; it lives in lib.sh so this stage and 00g cannot drift apart
# on it. susieR must be 0.11.92: 0.12+ moved bhat/shat/R/var_y out of
# susie_suff_stat into susie_rss, and finemapper.py calls the old signature.
rpy2_env
require_r_package susieR

read -r RID CHR BS BE LDR < <(awk -F, -v i="$((PBS_ARRAY_INDEX + 1))" \
  'NR==i{print $1, $2, $3, $4, $5}' blocks.csv)
[ -n "$RID" ] || { echo "no block at index ${PBS_ARRAY_INDEX}"; exit 1; }
OUT="polyfun_out_${SET}/${RID}.txt.gz"
[ -f "regions/$RID/EXCLUDED" ] && { echo "$RID: excluded by the unannotated-gap rule"; cat "regions/$RID/EXCLUDED"; exit 0; }
[ -s "$OUT" ] && { echo "$RID ($SET) already done"; exit 0; }

# finemapper wants a sumstats file with SNPVAR; the downloaded priors file
# already carries CHR SNP BP A1 A2 SNPVAR MAF N Z P.
W="${TMPDIR:-/tmp}/${RID}"; mkdir -p "$W"; trap 'rm -rf "$W"' EXIT
python - "pf_prior_${SET}/chol.${CHR}.snpvar_constrained.gz" \
         "$W/sumstats.parquet" "$BS" "$BE" "regions/$RID/snps.csv" <<'PY'
import sys, pandas as pd
src, dst, bs, be, snps = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), sys.argv[5]
d = pd.read_csv(src, sep='\t')      # CHR SNP BP A1 A2 SNPVAR MAF N Z
d = d[(d.BP >= bs) & (d.BP <= be)]
# Restrict to the SAME variant set the other methods see. Without this PolyFun
# fine-maps every variant its priors file carries in the block - including the
# indels and duplicate positions prep_block.py drops - so the three methods
# would be scoring different SNP sets. Measured on one block: 4,711 vs 4,238.
keep = set(pd.read_csv(snps)['SNP'])
n_all = len(d)
d = d[d.SNP.isin(keep)]
cols = [c for c in ['CHR','SNP','BP','A1','A2','SNPVAR','MAF','N','Z','P'] if c in d.columns]
d = d[cols]
d.to_parquet(dst, index=False)
print(f'{len(d)} variants with SNPVAR (of {n_all} in the block) after matching '
      f'the shared variant set', flush=True)
PY

require_env POLYFUN_DIR "the upstream polyfun checkout"
require_file "${POLYFUN_DIR}/finemapper.py" 1000
require_file "ld/${LDR}.npz" 1000000 "stage 01 incomplete"
require_file "$W/sumstats.parquet" 1000 "per-block sumstats build failed"
require_dir  "${POLYFUN_RLIB:?set POLYFUN_RLIB}" "susieR 0.11.92 must be installed here"
[ -d "${POLYFUN_RLIB}/susieR" ] || die "susieR not found in ${POLYFUN_RLIB}. finemapper.py needs 0.11.92 specifically: 0.12+ moved bhat/shat/R out of susie_suff_stat."

python "${POLYFUN_DIR}/finemapper.py" \
  --ld "ld/${LDR}" \
  --sumstats "$W/sumstats.parquet" \
  --n "${N_LIKELIHOOD:-373220}" \
  --chr "$CHR" --start "$BS" --end "$BE" \
  --method susie --max-num-causal 10 \
  --allow-missing \
  --out "$OUT"
check_output "$OUT" 1000
log "$RID ($SET) done"
finish
